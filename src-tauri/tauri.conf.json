{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HexNest Node Desktop",
  "version": "0.1.0",
  "identifier": "com.hexnest.node",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HexNest Node",
        "width": 1360,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true,
        "visible": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../public",
      "resources/sidecar"
    ]
  }
}