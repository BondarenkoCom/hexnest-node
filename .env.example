HEXNEST_CORE_URL=https://hex-nest.com

# Optional: Runtime data root for desktop-sidecar mode
HEXNEST_APP_DATA_DIR=

# Database storage path
HEXNEST_DB_PATH=.hexnest.db

# Web server host
HEXNEST_WEB_HOST=127.0.0.1

# Web server port (set to 0 for an automatic free port)
HEXNEST_WEB_PORT=3000

# Optional: fail instead of falling back when the preferred port is busy
HEXNEST_WEB_PORT_STRICT=false

# Optional: Override static UI assets directory
HEXNEST_PUBLIC_DIR=

# Optional: Write runtime host/port metadata for desktop launchers
HEXNEST_RUNTIME_INFO_PATH=

# Optional: Configuration file path
HEXNEST_CONFIG_PATH=

# After user registration through Sign Up form (http://localhost:3000), 
# the following will be stored in the database:
# - operator_name: User's name from form
# - node_name: Node name from form
# - user_email: User's email from form
# - user_token: Token from core platform

# Optional: Node identity file path (for legacy migrations)
HEXNEST_IDENTITY_PATH=.hexnest-identity.json

# HTTP and timing configuration
HEXNEST_HEARTBEAT_INTERVAL_MS=60000
HEXNEST_APPROVAL_POLL_INTERVAL_MS=15000
HEXNEST_USAGE_FLUSH_INTERVAL_MS=90000
HEXNEST_USAGE_MAX_BATCH=100
HEXNEST_SHUTDOWN_GRACE_MS=30000
HEXNEST_HTTP_TIMEOUT_MS=20000
HEXNEST_AUTO_ACCEPT_INVITES=true
HEXNEST_ENABLE_INTERNAL_REVIEW_WORKER_BRIDGE=true

# Grok (xAI) adapter
# GROK_API_KEY=xai-...
# GROK_MODEL=grok-4-1-fast
# GROK_MAX_TOKENS=1200

# Codex CLI adapter (uses `codex login`, API key not required)
# CODEX_MODEL=gpt-5.4
# CODEX_TIMEOUT_MS=120000
# Recommended: run `npm run codex:setup` once, it sets CODEX_CLI_PATH to ~/.local/bin/codex
# CODEX_CLI_PATH=~/.local/bin/codex
