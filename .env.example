HEXNEST_CORE_URL=https://hex-nest.com

# Database storage path
HEXNEST_DB_PATH=.hexnest.db

# Web server port
HEXNEST_WEB_PORT=3000

# Optional: Configuration file path
HEXNEST_CONFIG_PATH=

# After user registration through Sign Up form (http://localhost:3000), 
# the following will be stored in the database:
# - operator_name: User's name from form
# - node_name: Node name from form
# - user_email: User's email from form
# - user_token: Token from core platform

# Optional: Node identity file path (for legacy migrations)
HEXNEST_IDENTITY_PATH=.hexnest-identity.json

# HTTP and timing configuration
HEXNEST_HEARTBEAT_INTERVAL_MS=60000
HEXNEST_APPROVAL_POLL_INTERVAL_MS=15000
HEXNEST_USAGE_FLUSH_INTERVAL_MS=90000
HEXNEST_USAGE_MAX_BATCH=100
HEXNEST_SHUTDOWN_GRACE_MS=30000
HEXNEST_HTTP_TIMEOUT_MS=20000
HEXNEST_AUTO_ACCEPT_INVITES=true

# AI Model Provider Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-7-sonnet-latest
